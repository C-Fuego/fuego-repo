--- /dev/null
+++ b/apps/we-gui/src/platform/single_instance.rs
@@ -0,0 +1,135 @@
+use std::{
+    fs,
+    io::Write,
+    os::unix::net::{UnixListener, UnixStream},
+    path::PathBuf,
+    sync::OnceLock,
+};
+
+static SHOW_LISTENER: OnceLock<UnixListener> = OnceLock::new();
+
+const SHOW_REQUEST: &[u8] = b"show";
+
+/// Try to become the single primary we-gui instance.
+///
+/// Returns `true` when this process should run as the primary instance.
+/// Returns `false` when another instance is already listening; in that case a
+/// "show window" request was forwarded to it and the caller should exit.
+pub(crate) fn acquire_or_request_show() -> bool {
+    let path = socket_path();
+
+    if let Ok(listener) = UnixListener::bind(&path) {
+        install_listener(listener);
+        return true;
+    }
+
+    if request_show(&path) {
+        return false;
+    }
+
+    // The socket file exists but nobody answers: stale leftover from a crashed
+    // instance, so it is safe to remove and rebind.
+    let _ = fs::remove_file(&path);
+    match UnixListener::bind(&path) {
+        Ok(listener) => {
+            eprintln!("we-gui: recovered stale instance socket {}", path.display());
+            install_listener(listener);
+            true
+        }
+        Err(error) => {
+            eprintln!(
+                "we-gui: could not create instance socket ({error}); continuing without single-instance guard"
+            );
+            true
+        }
+    }
+}
+
+/// Poll for "show window" requests from secondary instances.
+///
+/// Any incoming connection counts as one request. The listener is
+/// non-blocking, so this is cheap to call from the regular tick handler.
+pub(crate) fn poll_show_request() -> bool {
+    let Some(listener) = SHOW_LISTENER.get() else { return false };
+    let mut requested = false;
+    while let Ok((_stream, _)) = listener.accept() {
+        requested = true;
+    }
+    requested
+}
+
+fn install_listener(listener: UnixListener) {
+    let _ = listener.set_nonblocking(true);
+    // If a listener was already installed this process is still the primary;
+    // the newly bound socket simply replaces the old one on disk.
+    let _ = SHOW_LISTENER.set(listener);
+}
+
+fn request_show(path: &PathBuf) -> bool {
+    let Ok(mut stream) = UnixStream::connect(path) else { return false };
+    stream.write_all(SHOW_REQUEST).is_ok()
+}
+
+fn socket_path() -> PathBuf {
+    if let Some(dir) = std::env::var_os("XDG_RUNTIME_DIR")
+        .filter(|value| !value.is_empty())
+        .map(PathBuf::from)
+        .filter(|value| value.is_absolute())
+    {
+        return dir.join("we-layerd/gui.sock");
+    }
+    PathBuf::from(format!("/tmp/we-layerd-gui-{}.sock", process_owner_uid()))
+}
+
+fn process_owner_uid() -> u32 {
+    #[cfg(target_os = "linux")]
+    {
+        use std::os::unix::fs::MetadataExt;
+        if let Ok(metadata) = fs::metadata("/proc/self") {
+            return metadata.uid();
+        }
+    }
+    0
+}
+
+#[cfg(test)]
+mod tests {
+    use super::{acquire_or_request_show, poll_show_request, socket_path};
+    use std::{os::unix::net::UnixListener, time::Duration, time::Instant};
+
+    // The instance socket is process-global state, so every scenario runs in
+    // one serialized test instead of parallel `#[test]` functions.
+    #[test]
+    fn single_instance_lifecycle_scenarios() {
+        let path = socket_path();
+        let _ = std::fs::remove_file(&path);
+
+        // Scenario 1: the first acquire wins and becomes primary.
+        assert!(acquire_or_request_show(), "first acquire should win the socket");
+
+        // Scenario 2: a secondary defers and its request reaches the primary.
+        let secondary =
+            std::thread::spawn(|| assert!(!acquire_or_request_show(), "secondary should defer"));
+        wait_for_show_request();
+        secondary.join().expect("secondary thread");
+
+        // Scenario 3: a leaked (stale) socket is recovered after rebinding.
+        let _ = std::fs::remove_file(&path);
+        let leaked = UnixListener::bind(&path).expect("bind leaked socket");
+        drop(leaked);
+        assert!(
+            acquire_or_request_show(),
+            "primary should recover a stale socket"
+        );
+
+        let _ = std::fs::remove_file(&path);
+    }
+
+    fn wait_for_show_request() {
+        let deadline = Instant::now() + Duration::from_secs(5);
+        while !poll_show_request() {
+            assert!(Instant::now() < deadline, "primary never observed show request");
+            std::thread::sleep(Duration::from_millis(10));
+        }
+    }
+}
