+use platform::single_instance;
+
+const USAGE: &str = concat!(
+    "we-gui - GUI companion for we-layerd\n",
+    "\n",
+    "Usage: we-gui [OPTIONS]\n",
+    "\n",
+    "Options:\n",
+    "      --hidden     Start without showing the main window (tray only)\n",
+    "  -h, --help       Print help\n",
+    "  -V, --version    Print version\n",
+    "\n",
+    "The main window can be reopened anytime from the tray icon (\"Show Window\").\n",
+    "Set `start_hidden = true` in ~/.config/we-layerd/gui.toml to make tray-only\n",
+    "startup the default.\n",
+);
+
+struct Options {
+    start_hidden: bool,
+}
+
 fn main() -> iced::Result {
-    let result = app::run();
+    let options = match parse_options(std::env::args().skip(1)) {
+        Ok(Some(options)) => options,
+        Ok(None) => return Ok(()),
+        Err(error) => {
+            eprintln!("we-gui: {error}\n\nRun `we-gui --help` for usage information.");
+            std::process::exit(2);
+        }
+    };
+
+    if !single_instance::acquire_or_request_show() {
+        eprintln!("we-gui is already running; asked it to show its window.");
+        return Ok(());
+    }
+
+    let result = app::run(options.start_hidden);
     if result.is_ok() && app::was_interrupted() {
         std::process::exit(130);
     }
     result
 }
+
+/// Parses CLI options. Returns `Ok(None)` when the program should exit early
+/// after printing help or version information.
+fn parse_options<I: Iterator<Item = String>>(arguments: I) -> Result<Option<Options>, String> {
+    let mut options = Options { start_hidden: false };
+    for argument in arguments {
+        match argument.as_str() {
+            "--hidden" => options.start_hidden = true,
+            "-h" | "--help" => {
+                print!("{USAGE}");
+                return Ok(None);
+            }
+            "-V" | "--version" => {
+                println!("we-gui {}", env!("CARGO_PKG_VERSION"));
+                return Ok(None);
+            }
+            other => return Err(format!("unrecognized argument '{other}'")),
+        }
+    }
+    Ok(Some(options))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::{parse_options, Options};
+
+    fn arguments(values: &[&str]) -> Vec<String> {
+        values.iter().map(|value| (*value).to_string()).collect()
+    }
+
+    #[test]
+    fn defaults_to_showing_the_window() {
+        let options = parse_options(arguments(&[]).into_iter()).expect("no arguments parse");
+        assert!(options.is_some_and(|options: Options| !options.start_hidden));
+    }
+
+    #[test]
+    fn hidden_flag_enables_tray_only_startup() {
+        let options = parse_options(arguments(&["--hidden"]).into_iter())
+            .expect("hidden flag parses")
+            .expect("options");
+        assert!(options.start_hidden);
+    }
+
+    #[test]
+    fn help_and_version_exit_early() {
+        assert!(parse_options(arguments(&["-h"]).into_iter()).expect("help parses").is_none());
+        assert!(parse_options(arguments(&["--help"]).into_iter()).expect("help parses").is_none());
+        assert!(parse_options(arguments(&["-V"]).into_iter()).expect("version parses").is_none());
+        assert!(
+            parse_options(arguments(&["--version"]).into_iter())
+                .expect("version parses")
+                .is_none()
+        );
+    }
+
+    #[test]
+    fn unknown_arguments_are_rejected() {
+        assert!(parse_options(arguments(&["--bogus"]).into_iter()).is_err());
+        assert!(parse_options(arguments(&["extra"]).into_iter()).is_err());
+    }
+}
