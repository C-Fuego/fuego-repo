pre_install() {
    :
}

post_install() {
    # Add the shim to the global ld.so.preload so every process (including
    # insecure-execution ones like niri) preloads it. The compositor's own
    # libinput context will then enable 3-finger drag on device hotplug.
    local preload='/etc/ld.so.preload'
    local entry='/usr/lib/libenable-3fg-drag.so'
    if ! grep -qxF "$entry" "$preload" 2>/dev/null; then
        echo "$entry" >> "$preload"
    fi
    ldconfig 2>/dev/null || true
}

pre_upgrade() {
    :
}

post_upgrade() {
    post_install
}

pre_remove() {
    :
}

post_remove() {
    # Remove the shim from ld.so.preload when the package is removed.
    local preload='/etc/ld.so.preload'
    local entry='/usr/lib/libenable-3fg-drag.so'
    if [ -f "$preload" ]; then
        sed -i "\|^$entry\$|d" "$preload"
    fi
    ldconfig 2>/dev/null || true
}
