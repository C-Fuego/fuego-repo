# Maintainer: C-Fuego
# Installs the fuego-repo master signing key into pacman's keyring so that
# `[fuego-repo]` can be used with SigLevel = Required without the manual
# `pacman-key --add && pacman-key --lsign-key` dance.
#
# The key is fetched from the published repository itself: the same bytes
# create-repository.sh exports to <repo>-key.asc, so this package always ships
# the key that actually signs the database and packages.  There is nothing to
# build -- the whole point is to carry that one file and register it.
pkgname=fuego-repo-keyring
pkgver=20261122
pkgrel=3
pkgdesc="Signing key for the fuego-repo pacman repository"
arch=('any')
url="https://ignacio.dpdns.org/x86_64-v3"
license=('custom')
depends=('pacman')
# No checksum: the key lives in an object store whose bytes are the authority,
# and pinning a hash here would need a bump every time the key is rotated.
# makepkg accepts SKIP for a file whose integrity is established downstream
# (the repository's own signature chain).
#
# The local name deliberately does NOT end in .asc: makepkg treats an .asc
# source as a detached signature and looks for the file it signs (it fails with
# "SOURCE FILE NOT FOUND"). The downloaded bytes are the armored public key, so
# it is stored as .pub and installed under its proper keyrings name below.
source=("fuego-repo-key.pub::https://ignacio.dpdns.org/x86_64-v3/fuego-repo-key.asc")
sha256sums=('SKIP')

package() {
  # pacman-key --populate reads <name>.gpg (a binary keyring), not the armored
  # .asc: it does `--import $KEYRING_IMPORT_DIR/<name>.gpg` and errors with
  # "The keyring file .../fuego-repo.gpg does not exist" otherwise. Ship the
  # binary form under that name, and keep the armored .asc for humans/tools
  # that expect the published file.
  install -Dm644 "$srcdir/fuego-repo-key.pub" \
    "$pkgdir/usr/share/pacman/keyrings/fuego-repo.asc"
  gpg --dearmor < "$srcdir/fuego-repo-key.pub" \
    > "$pkgdir/usr/share/pacman/keyrings/fuego-repo.gpg"

  # trusted: keys pacman may use to validate this repository's database.
  printf '%s\n' "2200497908F87275:4:" > "$pkgdir/usr/share/pacman/keyrings/fuego-repo-trusted"
  # revoked: empty on purpose.
  : > "$pkgdir/usr/share/pacman/keyrings/fuego-repo-revoked"

  # Register the key on install and drop it on removal, so `pacman -S
  # fuego-repo-keyring` is all a new machine needs.
  install -Dm644 /dev/stdin "$pkgdir/usr/share/libalpm/hooks/90-fuego-repo-keyring.hook" <<'HOOK'
[Trigger]
Operation = Install
Type = Package
Target = fuego-repo-keyring

[Action]
Description = Registering the fuego-repo signing key...
When = PostTransaction
Exec = /usr/bin/pacman-key --populate fuego-repo
HOOK

  install -Dm644 /dev/stdin "$pkgdir/usr/share/libalpm/hooks/91-fuego-repo-keyring-remove.hook" <<'HOOK'
[Trigger]
Operation = Remove
Type = Package
Target = fuego-repo-keyring

[Action]
Description = Removing the fuego-repo signing key...
When = PostTransaction
Exec = /usr/bin/pacman-key --updatedb
HOOK
}
