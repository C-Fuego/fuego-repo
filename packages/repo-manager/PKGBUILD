# Maintainer: C-Fuego
pkgname=repo-manager
pkgver=0.1.0
pkgrel=3
pkgdesc='TUI maintenance entry point for a fuego-repo Arch package repository'
arch=('any')
url='https://github.com/C-Fuego/fuego-repo'
license=('custom')
depends=('bash' 'git' 'fzf' 'python' 'pacman')
optdepends=(
  'github-cli: dispatch builds, sync AUR sources, and inspect Actions'
  'makepkg: import and validate local PKGBUILDs'
)
source=()
sha256sums=()

package() {
  install -Dm755 /dev/stdin "$pkgdir/usr/bin/repo-manager" <<'SCRIPT'
#!/usr/bin/env bash
set -Eeuo pipefail

readonly default_remote='git@github.com:C-Fuego/fuego-repo.git'

usage() {
  cat <<'HELP'
Usage: repo-manager --repo DIR [--no-push] [ACTION [ARGS...]]
       repo-manager init DIR [--remote URL] [--branch NAME]
       repo-manager update --repo DIR
       repo-manager --help

Open the fuego-repo TUI from a lightweight sparse checkout, or run ACTION directly.

  init DIR       Clone a blobless sparse maintenance checkout.
  update         Fast-forward an existing checkout from its configured upstream.
  --repo DIR     Required checkout path; no implicit current-directory discovery.
  --remote URL   Repository URL used by init (default: C-Fuego/fuego-repo).
  --branch NAME  Branch used by init (default: main).
  --no-push      Start manage.sh with automatic pushing disabled.

Examples:
  repo-manager --repo DIR --list
  repo-manager --repo DIR -- --help           # manage.sh help
  repo-manager --repo DIR packages --help    # package CLI help
  repo-manager --repo DIR packages list
  repo-manager --repo DIR build
HELP
}

repo_root=''
remote="$default_remote"
branch='main'
no_push=0

require_repo() {
  [[ -n "$explicit_repo" ]] || {
    printf '%s\n' '必须显式指定仓库位置：repo-manager --repo /path/to/fuego-repo' >&2
    printf '%s\n' '首次创建轻量维护副本：repo-manager init /path/to/fuego-repo-maint' >&2
    exit 2
  }
  repo_root="$(cd -- "$explicit_repo" 2>/dev/null && pwd -P)" || {
    printf '仓库目录不存在：%s\n' "$explicit_repo" >&2
    exit 1
  }
  git -C "$repo_root" rev-parse --is-inside-work-tree >/dev/null 2>&1 || {
    printf '不是 Git 工作树：%s\n' "$repo_root" >&2
    exit 1
  }
  [[ -f "$repo_root/manage.sh" && -d "$repo_root/packages" ]] || {
    printf '不是 fuego-repo 维护副本（缺少 manage.sh 或 packages/）：%s\n' "$repo_root" >&2
    exit 1
  }
}

init_repo() {
  local target="$1"
  [[ "$target" = /* ]] || target="$PWD/$target"
  if [[ -e "$target" ]]; then
    printf '目标已存在：%s\n' "$target" >&2
    return 2
  fi
  git clone --filter=blob:none --no-checkout --branch "$branch" "$remote" "$target"
  git -C "$target" sparse-checkout init --cone
  git -C "$target" sparse-checkout set --no-cone \
    manage.sh scripts config packages .gitignore .gitattributes
  repo_root="$(cd -- "$target" && pwd -P)"
  printf '已创建维护入口：%s\n' "$repo_root"
}

update_repo() {
  git -C "$repo_root" pull --ff-only
}

require_value() {
  if [[ -z "${2:-}" || "$2" == --* ]]; then
    printf '选项 %s 需要一个值。\n' "$1" >&2
    exit 2
  fi
}

if [[ "${1:-}" == 'init' ]]; then
  shift
  case "${1:-}" in
    -h|--help) usage; exit 0 ;;
    ''|-*) printf 'init 需要目标目录\n' >&2; exit 2 ;;
  esac
  target="$1"; shift
  while (($#)); do
    case "$1" in
      --remote) require_value "$@"; remote="$2"; shift 2 ;;
      --branch) require_value "$@"; branch="$2"; shift 2 ;;
      -h|--help) usage; exit 0 ;;
      *) printf '未知选项：%s\n' "$1" >&2; exit 2 ;;
    esac
  done
  init_repo "$target"
  exec "$repo_root/manage.sh" --no-push
fi

explicit_repo=''
update_requested=0
# Parse only the launcher prefix. Once the manage.sh action begins, values such
# as a package named "update" or its subcommand's --help must pass unchanged.
while (($#)); do
  case "$1" in
    --repo) require_value "$@"; explicit_repo="$2"; shift 2 ;;
    --no-push) no_push=1; shift ;;
    update)
      if (( update_requested )); then
        printf 'update 只能指定一次。\n' >&2
        exit 2
      fi
      update_requested=1; shift ;;
    -h|--help) usage; exit 0 ;;
    --) shift; break ;;
    *) break ;;
  esac
done

if (( update_requested )) && (( $# )); then
  printf 'update 不接受此参数：%s\n' "$1" >&2
  exit 2
fi
require_repo

if (( update_requested )); then
  update_repo
  exit 0
fi
[[ -x "$repo_root/manage.sh" ]] || chmod +x "$repo_root/manage.sh"
if (( no_push )); then
  set -- --no-push "$@"
fi
exec "$repo_root/manage.sh" "$@"
SCRIPT

  install -Dm644 /dev/stdin "$pkgdir/usr/share/licenses/$pkgname/LICENSE" <<'LICENSE'
MIT License

Copyright (c) 2026 C-Fuego

Permission is hereby granted, free of charge, to any person obtaining a copy
of this software and associated documentation files, to deal in the Software
without restriction, including without limitation the rights to use, copy,
modify, merge, publish, distribute, sublicense, and/or sell copies.
LICENSE
}
