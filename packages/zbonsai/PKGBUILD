# Maintainer: C-Fuego
pkgname=zbonsai
pkgver=0.1.0
pkgrel=2
pkgdesc="cbonsai clone written in Zig"
arch=('x86_64')
options=('!debug' '!strip')
url="https://github.com/C-Fuego/Rezig"
license=('MIT')
depends=()
makedepends=('zig')
_commit=54f24d2a35434b4e77e4b6bcef97378e4c4d9d24
source=("$pkgname::git+https://github.com/C-Fuego/Rezig#commit=$_commit")
sha256sums=('SKIP')


build() {
  cd "$srcdir/zbonsai/zbonsai/src"
  ZIG_GLOBAL_CACHE_DIR="$srcdir/.zig-global" zig build -Doptimize=ReleaseFast -Dcpu=x86_64_v3 \
    --prefix "$srcdir/out" --cache-dir "$srcdir/.zig-cache"
}

package() {
  cd "$srcdir/zbonsai/zbonsai/src"
  install -Dm755 "$srcdir/out/bin/zbonsai" "$pkgdir/usr/bin/zbonsai"
  [ -f LICENSE ] && install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  return 0
}
