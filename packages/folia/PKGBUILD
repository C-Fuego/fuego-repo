# Maintainer: C-Fuego
# x86_64-v3 优化包：从 TeChuouo520/Folia-rust 源码 cargo build 出 folia-app。
# 由 CI 构建发布到 [fuego-repo]，也可本机 makepkg -si 编译。运行时资源（assets）与二进制同目录。
pkgname=folia
pkgver=0.1.3
pkgrel=2
pkgdesc="歌词可视化音乐播放器（Folia-rust，原生 Rust，x86-64-v3 优化）"
arch=('x86_64')
url="https://github.com/Techuouo520/Folia-rust"
license=('AGPL-3.0-only')
# Folia 运行所需动态库（音频/窗口/图形）——这些是运行期依赖
depends=('gcc-libs' 'glibc' 'alsa-lib' 'dbus' 'libxkbcommon' 'mesa' 'vulkan-icd-loader' 'wayland' 'fontconfig')
# 编译期依赖：rust 工具链 + pkgconf + python（构建脚本）+ X11/Wayland 头文件
makedepends=('rust' 'pkgconf' 'python' 'wayland' 'libx11' 'libxcb' 'libxkbcommon')
# !lto：zstd-sys 等 -sys crate 会用 makepkg 注入的 -flto=auto 编出 GCC 的 GIMPLE 目标文件，
# 而 CachyOS 的 rust 用 lld 链接，读不懂它们，报 undefined symbol: ZSTD_compress2。
options=('!strip' '!debug' '!lto')
# 源码：跟最新 tag（本地更新时把 pkgver 改到新 tag 即可）
_tag="v${pkgver}"
source=("$pkgname::git+https://github.com/Techuouo520/Folia-rust#tag=$_tag")
sha256sums=('SKIP')

build() {
  cd "$srcdir/$pkgname"
  # x86-64-v3 微架构优化（AVX2/BMI2/FMA）；本机 CPU 需支持 v3。
  export RUSTFLAGS="-C target-cpu=x86-64-v3"
  # 用仓库锁定的依赖版本；只编 GUI 可执行 crate。
  cargo build --release --locked -p folia-app
}

package() {
  cd "$srcdir/$pkgname"
  # 程序的资源定位：current_exe().parent()/assets —— 所以二进制和 assets 必须同目录。
  install -d "$pkgdir/usr/lib/folia"
  install -Dm755 "$srcdir/$pkgname/target/release/folia" "$pkgdir/usr/lib/folia/folia"
  cp -a "$srcdir/$pkgname/assets" "$pkgdir/usr/lib/folia/assets"

  # 源码里 assets/models 只有 manifest/License，无 .bin 模型（懒加载，缺失仅影响节拍/分轨分析）。
  # 想启用分析功能可手动把官方模型放进 /usr/lib/folia/assets/models/。

  install -d "$pkgdir/usr/bin"
  ln -s /usr/lib/folia/folia "$pkgdir/usr/bin/folia"

  install -Dm644 "$srcdir/$pkgname/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"

  install -Dm644 "$srcdir/$pkgname/assets/icon.png" \
    "$pkgdir/usr/share/icons/hicolor/512x512/apps/folia.png"
  install -Dm644 /dev/stdin "$pkgdir/usr/share/applications/folia.desktop" <<'DESKTOP'
[Desktop Entry]
Type=Application
Name=Folia
Comment=歌词可视化音乐播放器
Exec=folia
Icon=folia
Terminal=false
Categories=AudioVideo;Audio;Player;
StartupNotify=true
DESKTOP
}
