# Maintainer: C-Fuego
pkgname=zeraora
pkgver=0.3.0
pkgrel=2
pkgdesc="Print pokemon sprites in your terminal"
arch=('x86_64')
options=('!debug' '!strip')
url="https://github.com/C-Fuego/Rezig"
license=('GPL-3.0-only')
depends=()
makedepends=('zig')
_commit=54f24d2a35434b4e77e4b6bcef97378e4c4d9d24
# zeraora 是 Rezig 仓库根下的独立子项目（不是 <pkg>/<pkg>/src 结构）
source=("$pkgname::git+https://github.com/C-Fuego/Rezig#commit=$_commit")
sha256sums=('SKIP')


build() {
  cd "$srcdir/$pkgname/zeraora"
  ZIG_GLOBAL_CACHE_DIR="$srcdir/.zig-global" zig build -Doptimize=ReleaseFast -Dcpu=x86_64_v3 \
    --prefix "$srcdir/out" --cache-dir "$srcdir/.zig-cache" --summary all
}

check() {
  cd "$srcdir/$pkgname/zeraora"
  ZIG_GLOBAL_CACHE_DIR="$srcdir/.zig-global" zig build test -Doptimize=ReleaseFast \
    --cache-dir "$srcdir/.zig-cache"
}

package() {
  cd "$srcdir/$pkgname/zeraora"
  install -Dm755 "$srcdir/out/bin/zeraora" "$pkgdir/usr/bin/zeraora"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
