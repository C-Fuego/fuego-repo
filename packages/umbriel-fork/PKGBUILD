# Maintainer: C-Fuego
pkgname=umbriel-fork
pkgver=0.1.0.r262.dc5c86f
pkgrel=3
pkgdesc='Umbriel Wayland compositor with the C-Fuego agent seat and shake-to-enlarge cursor'
arch=('x86_64')
url='https://github.com/C-Fuego/umbriel'
license=('MIT')
_commit=dc5c86f621bc7d44ac978b8e0eb3ef5ed7f3b1c5
provides=("umbriel=$pkgver")
conflicts=('umbriel')
depends=(
  'cairo' 'gcc-libs' 'glibc' 'jemalloc' 'lcms2' 'libdisplay-info>=0.3.0'
  'libdrm>=2.4.129' 'libei>=1.3' 'libglvnd' 'libinput>=1.29' 'libxcb'
  'libxkbcommon>=1.10.0' 'mesa' 'pango' 'pixman>=0.43.0' 'systemd-libs'
  'tomlplusplus' 'wayland>=1.24' 'wlroots0.20>=0.20.1' 'xcb-util-wm' 'xorg-xwayland'
)
makedepends=('meson' 'ninja' 'nlohmann-json' 'pkgconf' 'wayland-protocols>=1.47')
optdepends=(
  'grim: capture screenshots for computer-use workflows'
  'kitty: terminal used by the default key binding'
  'xdg-desktop-portal-umbriel: desktop portal for screenshots and screen sharing'
)
source=("${pkgname}-${_commit}.tar.gz::https://codeload.github.com/C-Fuego/umbriel/tar.gz/${_commit}")
sha256sums=('0263b3e17fbd8ab65ca2fa936d5fd86076829fd2eb16bb4066e21b98a806b03b')

prepare() {
  cd "umbriel-${_commit}"
  # The source archive has no Git metadata; preserve its revision in the binary.
  sed -i "s/'unknown'/'${_commit:0:12}'/g" meson.build
}

build() {
  arch-meson "umbriel-${_commit}" build --buildtype=release --wrap-mode=nodownload \
    -Dtests=disabled -Dharness=disabled -Djemalloc=enabled -Dlcms2=enabled -Dlocaled=enabled
  meson compile -C build
}

check() {
  build/umbriel --version
  build/umbriel config validate -c "umbriel-${_commit}/examples/config.toml"
}

package() {
  DESTDIR="$pkgdir" meson install -C build --no-rebuild
  install -Dm644 "umbriel-${_commit}/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "umbriel-${_commit}/umbrielfx/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/umbrielfx/LICENSE"
  install -Dm644 "umbriel-${_commit}/docs/user/automation.md" "$pkgdir/usr/share/doc/$pkgname/automation.md"
}
